---
// This is my substitute for the About page from the old site.
import { version } from '../../package.json';
const date = new Date();
const year = date.getFullYear();
const buildDate = date.toLocaleDateString('en-US', { month: 'long' }) + ', ' + year;
declare const __COMMIT_HASH__: string;
---

<footer class="site-footer">
    <hr>
    <p>version {version} &bull; <a href={`https://github.com/forcequitOS/forcequit.cc/commit/${__COMMIT_HASH__}`}>{__COMMIT_HASH__}</a> ({buildDate})</p>
    <p>&copy; {year} forcequit.</p>
</footer>

<style>
    .site-footer {
        color: var(--text-tertiary);
        font-size: 12px;
        max-width: 800px;
        margin: 0 auto;
        margin-top: 20px;
    }

    .site-footer p {
        margin: 0;
    }

    .site-footer a {
        color: var(--text-secondary);
    }

    .site-footer a:hover {
        color: var(--text);
    }
</style>